# ==============================================================================
# Binance Futures API Credentials
# ==============================================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# ==============================================================================
# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# ==============================================================================
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DB_CONNECTION_STRING=postgresql://postgres.your_project_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your_project_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Local PostgreSQL (Optional / Fallback)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orders_signal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ClickHouse (Optional / Historical tick storage)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=orders_signal

# ==============================================================================
# Telegram Real-Time Signal & Risk Notifier (Optional)
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==============================================================================
# Trading Engine Parameters
# ==============================================================================
TRADING_SYMBOL=BTCUSDT
TRADING_LEVERAGE=5
MAX_POSITION_SIZE=0.01
RISK_PER_TRADE=0.02

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=INFO
LOG_DIR=logs
